{
  "name": "pm-system-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "PM System — instalação local (desktop), sem depender de um servidor web",
  "main": "main.js",
  "scripts": {
    "prepare:resources": "node scripts/prepare-resources.js",
    "start": "npm run prepare:resources && electron .",
    "dist": "npm run prepare:resources && electron-builder"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pmsystem.desktop",
    "productName": "PM System",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/backend", "to": "backend" },
      { "from": "resources/frontend", "to": "frontend" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "msi", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
